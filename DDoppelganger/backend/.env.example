# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.

OPENAI_API_KEY="xxx"

# Chat + embedding models
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Database (defaults to a local SQLite file if unset — swap for a Postgres URL,
# e.g. postgresql+psycopg2://user:password@host:5432/doppelganger, in production)
DATABASE_URL="sqlite:///./doppelganger.db"

# JWT auth
JWT_SECRET_KEY="change-this-to-a-long-random-string"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="1440"

# Simple per-user daily token/cost guardrail for the demo phase
DAILY_AI_CALL_LIMIT="200"

# CORS
FRONTEND_ORIGIN="http://localhost:5173"
